# ==========================================
# Server Configuration
# ==========================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://accounts.orviohub.localhost:4000
JWT_SECRET=replace-with-a-32-character-minimum-secret
INVITATION_EXPIRY_DAYS=7

# ==========================================
# Database (Convex Cloud)
# ==========================================
CONVEX_URL=https://your-deployment.convex.cloud

# ==========================================
# Payment Gateways (Nigeria - NGN)
# ==========================================
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
FLUTTERWAVE_ENCRYPTION_KEY=...
FLUTTERWAVE_WEBHOOK_SECRET_HASH=...

# ==========================================
# Email Providers
# ==========================================
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=noreply@orviohub.com
EMAIL_FROM_NAME=OrvioHub

# ==========================================
# SMS Providers (Termii Nigeria & Twilio Global Fallback)
# ==========================================
TERMII_API_KEY=
TERMII_SENDER_ID=OrvioHub
TERMII_BASE_URL=https://api.ng.termii.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================================
# Social Authentication (OAuth)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/auth/facebook/callback

# ==========================================
# Platform Admin Override & Observability
# ==========================================
ADMIN_USER_ID=
SENTRY_DSN=
BETTERSTACK_LOGTAIL_TOKEN=
